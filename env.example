# ===== ATTENTION BANK — настройки =====
# Скопируйте этот файл в .env и заполните нужное.

# Порт веб-сервера
PORT=3000

# Публичный адрес сайта (нужен для ссылок в Telegram). Локально: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Путь к базе данных SQLite (создаётся автоматически)
DB_PATH=./data/attention-bank.db

# Заполнить базу демо-данными при первом запуске (1 = да, 0 = нет)
SEED_DEMO=1

# ----- Telegram -----
# Токен бота от @BotFather. Без токена сайт работает, но уведомления в Telegram не уходят.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (например attention_bank_bot)
TELEGRAM_BOT_USERNAME=
# ID группы/канала, куда бот публикует новые задания (например -1001234567890). Бота нужно добавить в группу админом.
TELEGRAM_GROUP_ID=
# Режим получения сообщений: polling (просто, работает локально) или webhook (для сервера с HTTPS)
TELEGRAM_MODE=polling
# Секрет для webhook (Telegram присылает его хэш в заголовке, чужие запросы отклоняются)
TELEGRAM_WEBHOOK_SECRET=change-me
# Бонус за подтверждение аккаунта через Telegram (в AB). 0 — без бонуса.
TELEGRAM_VERIFY_BONUS=10

# ----- Экономика (иллюстративная модель для MVP) -----
# Комиссия платформы с каждого ПОДТВЕРЖДЁННОГО результата, в процентах от награды
PLATFORM_FEE_PERCENT=20
# Сколько тенге стоит 1 AB для компании (только для отображения бюджета)
AB_TO_KZT=10
# Максимум отправленных заданий одним пользователем в сутки (антифрод)
DAILY_SUBMISSION_LIMIT=10
